# Filmoteca — variables de entorno. Copia a .env y rellena.
# El .env real está en .gitignore. NUNCA lo subas.

# ── Base de datos (PostgreSQL) ─────────────────────────────────────────────────
# Cualquier Postgres vale. Con Neon (plan gratuito) salen las dos de su panel:
# la "pooled" y la directa. Con un Postgres normal, pon la misma en las dos.
DATABASE_URL="postgresql://usuario:contraseña@servidor/basededatos?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:contraseña@servidor/basededatos?sslmode=require"

# ── Acceso (usuario único) ─────────────────────────────────────────────────────
# Filmoteca es de una sola persona: tú. No hay registro ni multiusuario.
ADMIN_USER="tu-usuario"
# Genera el secreto con:  openssl rand -hex 32
NEXTAUTH_SECRET="cambiame-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"
# La contraseña NO vive aquí: vive en la tabla `admin_credential`, hasheada con
# scrypt. Créala (o resetéala si te quedas fuera) con:
#     npm run admin:password -- 'tu contraseña'
# Mientras esa fila no exista puedes arrancar con un hash aquí; en cuanto exista,
# manda la fila. Sin ninguna de las dos, el login falla cerrado: no entra nadie.
# Los \$ van escapados A PROPÓSITO: Next expande $VAR al leer el .env y el hash
# se quedaría en «scrypt6384». En el panel de tu hosting va sin escapar.
ADMIN_PASSWORD_HASH="scrypt\$16384\$8\$1\$<salt-base64>\$<hash-base64>"

# ── Datos de películas ─────────────────────────────────────────────────────────
# TMDB (obligatoria): el bearer v4 en https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=""
# OMDb (obligatoria): key gratuita en https://www.omdbapi.com/apikey.aspx
# El plan gratuito da 1.000 peticiones/día y las respuestas se cachean 24 h.
OMDB_API_KEY=""

# ── Imágenes: Cloudinary (opcional) ────────────────────────────────────────────
# Sin esto la app funciona: usa los pósters de TMDB. Hace falta solo para subir
# tus propias fotos y pósters alternativos.
# El preset debe ser "unsigned" (Settings → Upload → Upload presets).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""          # solo para BORRAR imágenes
CLOUDINARY_API_SECRET=""       # solo para BORRAR imágenes
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_TAG="pelicula"

# ── IA (opcional) ──────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY: el buscador en lenguaje natural de «Qué ver»
# («algo corto y de los 90 que no haya visto»). Es lo único de la app web que
# usa IA; sin la clave, esa página lo dice y el resto funciona igual.
ANTHROPIC_API_KEY=""
# GEMINI_API_KEY: solo para dos scripts que se corren a mano
# (scripts/generate-lgbt-top.js y scripts/update-visual-tones.ts).
# La app web nunca la lee.
GEMINI_API_KEY=""

# ── Marca (opcional) ───────────────────────────────────────────────────────────
# El nombre de TU instancia. Las lee lib/branding.ts. Next las hornea al
# construir: después de cambiarlas hay que rebuild, no basta con reiniciar.
NEXT_PUBLIC_APP_NAME="Filmoteca"
NEXT_PUBLIC_APP_TAGLINE="Diario de cine"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Firma del pie de página. Vacía = sin pie.
NEXT_PUBLIC_APP_AUTHOR=""

# ── Bugsnag (opcional) ─────────────────────────────────────────────────────────
# Sin ella el script no se carga y la app no envía nada a ningún sitio.
NEXT_PUBLIC_BUGSNAG_API_KEY=""
