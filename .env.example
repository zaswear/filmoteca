# Filmoteca — environment variables. Copy to .env and fill in.
# The real .env is gitignored. NEVER commit it.

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Any Postgres works. With Neon (free tier) both come from its dashboard: the
# pooled one and the direct one. With a plain Postgres, use the same for both.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"

# ── Access (single user) ───────────────────────────────────────────────────────
# Filmoteca is for one person: you. No sign-up, no multi-user.
ADMIN_USER="your-username"
# Generate the secret with:  openssl rand -hex 32
NEXTAUTH_SECRET="change-me-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"
# The password does NOT live here: it lives in the `admin_credential` table,
# hashed with scrypt. Create it (or reset it if you're locked out) with:
#     npm run admin:password -- 'your password'
# Until that row exists you can boot with a hash here; once it does, the row
# wins. With neither, login fails closed: nobody gets in.
# The \$ are escaped ON PURPOSE: Next expands $VAR when reading .env and the
# hash would end up as «scrypt6384». In your host's panel, paste it unescaped.
ADMIN_PASSWORD_HASH="scrypt\$16384\$8\$1\$<salt-base64>\$<hash-base64>"

# ── Film data ──────────────────────────────────────────────────────────────────
# TMDB (required): the v4 bearer at https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=""
# OMDb (required): free key at https://www.omdbapi.com/apikey.aspx
# The free tier gives 1,000 requests/day and responses are cached for 24 h.
OMDB_API_KEY=""

# ── Images: Cloudinary (optional) ──────────────────────────────────────────────
# The app works without this: it uses TMDB posters. You only need it to upload
# your own photos and alternative posters.
# The preset must be "unsigned" (Settings → Upload → Upload presets).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""          # only needed to DELETE images
CLOUDINARY_API_SECRET=""       # only needed to DELETE images
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_TAG="film"

# ── AI (optional) ──────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY: the natural-language picker on «What to watch»
# ("something short from the 90s I haven't seen"). It's the only part of the web
# app that uses AI; without the key that page says so and the rest works fine.
ANTHROPIC_API_KEY=""
# GEMINI_API_KEY: only for two scripts you run by hand
# (scripts/generate-lgbt-top.js and scripts/update-visual-tones.ts).
# The web app never reads it.
GEMINI_API_KEY=""

# ── Language (optional) ────────────────────────────────────────────────────────
# "es" (default) or "en". Switches the whole interface, the language requested
# from TMDB, date formatting and the decimal separator. Next bakes it in at
# build time: changing it needs a rebuild, not a restart.
NEXT_PUBLIC_APP_LOCALE="en"

# ── Cinema listings (optional) ─────────────────────────────────────────────────
# Cities for the "In cinemas" filter, comma-separated. The first one is
# preselected. Empty = no city filter.
NEXT_PUBLIC_CINEMA_CITIES=""

# ── Branding (optional) ────────────────────────────────────────────────────────
# Your instance's name. Read by lib/branding.ts. Next bakes these in at build
# time too.
NEXT_PUBLIC_APP_NAME="Filmoteca"
NEXT_PUBLIC_APP_TAGLINE="Film diary"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Footer signature. Empty = no footer.
NEXT_PUBLIC_APP_AUTHOR=""

# ── Bugsnag (optional) ─────────────────────────────────────────────────────────
# Without it the script isn't loaded and the app sends nothing anywhere.
NEXT_PUBLIC_BUGSNAG_API_KEY=""
