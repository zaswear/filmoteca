{
  "name": "filmoteca",
  "version": "1.0.0",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "admin:password": "node scripts/admin-password.mjs",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@prisma/client": "^5.22.0",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "next-cloudinary": "^6.17.5",
    "papaparse": "^5.5.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT",
  "description": "Self-hosted film diary: log, rate and review the films you watch.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaswear/filmoteca.git"
  },
  "keywords": [
    "movie-diary",
    "self-hosted",
    "letterboxd-alternative",
    "nextjs",
    "prisma",
    "imdb",
    "tmdb"
  ],
  "engines": {
    "node": ">=20.9"
  }
}
